{
  "name": "@totto2727/effect-http",
  "version": "0.1.1",
  "description": "Small HTTP negotiation, caching, and security utilities for Effect",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totto2727-org/effect-http.git"
  },
  "files": [
    "dist",
    "NOTICE",
    "docs/upstream-differences.md",
    "docs/hono-compatibility.md"
  ],
  "type": "module",
  "exports": {
    "./accepts": {
      "types": "./dist/accepts.d.ts",
      "import": "./dist/accepts.js"
    },
    "./cacheControl": {
      "types": "./dist/cacheControl.d.ts",
      "import": "./dist/cacheControl.js"
    },
    "./conditionalRequest": {
      "types": "./dist/conditionalRequest.d.ts",
      "import": "./dist/conditionalRequest.js"
    },
    "./csrf": {
      "types": "./dist/csrf.d.ts",
      "import": "./dist/csrf.js"
    },
    "./responseCache": {
      "types": "./dist/responseCache.d.ts",
      "import": "./dist/responseCache.js"
    },
    "./secureHeaders": {
      "types": "./dist/secureHeaders.d.ts",
      "import": "./dist/secureHeaders.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@totto2727/gitignore-patterns": "^0.1.0",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.19.1",
    "effect": "^4.1.4",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
